#!/usr/bin/env bash
# Install the Mac mini's LaunchDaemons and start them:
#   com.local-shazam.deploy  runs scripts/deploy at every boot
#   com.local-shazam.vlm     keeps mlx_vlm.server running on 0.0.0.0:8080
#   com.local-shazam.flux    keeps local-shazam-flux (Flux.2 Klein edits) running on 0.0.0.0:8081
# Run on the Mac mini from the checkout at ~/ai-photo-frame-server:
#   ssh -t mini ~/ai-photo-frame-server/scripts/install-mac-mini
set -euo pipefail
cd "$(dirname "$0")/.."

for label in com.local-shazam.deploy com.local-shazam.vlm com.local-shazam.flux; do
  target="/Library/LaunchDaemons/$label.plist"
  plutil -lint "deploy/$label.plist"
  sudo install -m 644 -o root -g wheel "deploy/$label.plist" "$target"
  sudo launchctl bootout "system/$label" 2>/dev/null || true
  sudo launchctl bootstrap system "$target"
  echo "installed $target"
done
echo "logs: ~/Library/Logs/local-shazam-*.log"
