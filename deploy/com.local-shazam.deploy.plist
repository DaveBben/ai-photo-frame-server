<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-shazam.deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dave/ai-photo-frame-server/scripts/deploy</string>
  </array>
  <key>UserName</key>
  <string>dave</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/dave</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Rerun after a failed exit, such as a fetch before the network is up at boot. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/dave/Library/Logs/local-shazam-deploy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dave/Library/Logs/local-shazam-deploy.log</string>
</dict>
</plist>
